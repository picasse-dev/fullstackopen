//Esta mierda es sensible a saltos de linea wtf
#   Parte	            Función
# POST ...	    Define el método HTTP y la URL.
# Content-Type: ...	Indica el tipo de contenido que enviarás.
# Línea vacía	Separa los encabezados del cuerpo (body).
# {...}	        Es el cuerpo de la solicitud, en formato JSON.

# La línea vacía indica dónde terminan los headers y dónde comienza el body.
# Si eliminas esa separación, el cliente HTTP podría interpretar incorrectamente la solicitud.
GET http://localhost:3001/api/notes/


### DELETE - Eliminar una nota por ID
DELETE http://localhost:3001/api/notes/1

###
POST http://localhost:3001/api/notes
Content-Type: application/json; charset=utf-8

{
    "content": "Postman testing backend",
    "important": true
}

###
POST http://localhost:3001/api/notes/ HTTP/1.1
content-type: application/json

{
    "name": "sample",
    "time": "Wed, 21 Oct 2015 18:27:50 GMT"
}