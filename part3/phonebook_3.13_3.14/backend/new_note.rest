
@baseUrl = http://localhost:3001
@personsUrl = {{baseUrl}}/api/persons

@personId = 6b0a0409c07fdf803b4dc93c
@invalidId = 999999
@nonExistentId = 99999999999999999999999999

### ==================================================
### 1. GET - READ
### ==================================================

### 1.1 Get all persons
GET {{personsUrl}}
Accept: application/json

### 1.2 Get persons information (total count)
GET {{personsUrl}}/info
Accept: application/json

### 1.3 Get person by ID
GET {{personsUrl}}/{{personId}}
Accept: application/json

### 1.4 Get person - Invalid ID format (400)
GET {{personsUrl}}/{{invalidId}}
Accept: application/json

### 1.5 Get person - Valid MongoDB ID but not found (404)
GET {{personsUrl}}/{{nonExistentId}}
Accept: application/json


